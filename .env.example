# Execução local: npm run dev inicia frontend, API e host de fontes. .env e Redis são opcionais.
BACKEND_PORT=4000
BACKEND_HOST=127.0.0.1
# Vazio usa /api, encaminhado pelo Vite à API local.
VITE_API_BASE_URL=
# Opcional: origem do backend usada apenas pelo proxy de desenvolvimento/preview.
DEV_API_PROXY_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT=180
# Cota separada para imagens, manifests e segmentos do player.
MEDIA_RATE_LIMIT=600
API_RATE_WINDOW_MS=60000

# Somente no backend. Não use prefixo VITE_ nestas variáveis.
ANILIST_GRAPHQL_URL=https://graphql.anilist.co
MANGADEX_API_URL=https://api.mangadex.org
# UUIDs de grupos que solicitaram remoção de suas edições, separados por vírgula.
MANGADEX_BLOCKED_GROUP_IDS=

# Toko é um serviço separado; seu código não é instalado nem copiado automaticamente.
TOKO_API_URL=http://127.0.0.1:8099
TOKO_ENABLED=false
TOKO_TIMEOUT_MS=8000
TOKO_RETRIES=1
# Ative apenas quando tiver permissão para o conteúdo dos provedores indicados.
TOKO_CONTENT_AUTHORIZED=false
TOKO_ALLOWED_PROVIDERS=
# Domínios DNS exatos de mídia/legenda permitidos, separados por vírgula.
TOKO_ALLOWED_MEDIA_HOSTS=
# Origens HTTPS exatas permitidas para Referer/Origin de imagens públicas.
TOKO_ALLOWED_REQUEST_ORIGINS=

# Host local Node incorporado do Tatakai sob MPL-2.0.
HPMOVIES_SOURCE_HOST_PORT=8099
# Arquivo LOCAL com manifestos/bundles CJS explicitamente escolhidos e SHA-256.
HPMOVIES_EXTENSIONS_FILE=
TATAKAI_API_URL=http://127.0.0.1:8099
TATAKAI_ENABLED=true
TATAKAI_NAMESPACE=toko
TATAKAI_TIMEOUT_MS=8000
TATAKAI_RETRIES=0
TATAKAI_CONTENT_AUTHORIZED=false
TATAKAI_ALLOWED_PROVIDERS=
TATAKAI_ALLOWED_MEDIA_HOSTS=
TATAKAI_ALLOWED_REQUEST_ORIGINS=
# Addons HTTP/JSON, sem instalar executáveis; configuração privada do operador.
STREMIO_ADDONS_JSON=[]

ENABLE_LEGACY_HIANIME=false
# Redis opcional; o cache limitado em memória já funciona sem ele.
# ANIWATCH_API_REDIS_CONN_URL=redis://127.0.0.1:6379

# Legendas PT-BR/PT: OpenSubtitles REST/v3 e lançamentos curados revisados.
# Falhas das legendas não interrompem o vídeo.
EXTERNAL_SUBTITLES_ENABLED=true

# Tradução opcional local de faixas existentes; modelo instalado por npm run setup:translator.
# npm run dev inicia o serviço quando o modelo está no cache local.
AUTOMATIC_SUBTITLES_ENABLED=true
AUTOMATIC_SUBTITLES_URL=http://127.0.0.1:5000

# Domínios específicos de CDN de vídeo e legendas, incluindo seus subdomínios.
# Vazios por padrão. Não afetam imagens; não informe TLDs como com ou space.
TOKO_ALLOWED_STREAM_DOMAINS=
TATAKAI_ALLOWED_STREAM_DOMAINS=
