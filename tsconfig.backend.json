{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "outDir": "./dist/backend",
    "rootDir": "./src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": false,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src/aniwatch-apis/src/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "dist"]
}
