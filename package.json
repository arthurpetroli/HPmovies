{
  "name": "hpmovie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names FONTES,API,WEB \"npm run dev:source-host\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/aniwatch-apis/src/server.ts",
    "dev:frontend": "vite",
    "build": "npm run typecheck && vite build && npm run build:backend",
    "start": "npm run start:backend",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start:backend": "node dist/backend/aniwatch-apis/src/server.js",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.backend.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "diagnose:aniwatch": "node scripts/diagnose-aniwatch.mjs",
    "test:e2e": "playwright test",
    "test:streaming:real": "node scripts/check-real-playback.mjs",
    "dev:source-host": "node scripts/start-source-host.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "aniwatch": "^2.24.3",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "envalid": "^8.0.0",
    "hls.js": "^1.6.15",
    "hono": "^4.6.14",
    "hono-rate-limiter": "^0.4.2",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.554.0",
    "pino": "^9.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.14",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.46.3",
    "vite": "npm:rolldown-vite@7.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
