# A plataforma completa usa o .env.example da RAIZ e npm run dev na raiz.
# Valores abaixo também permitem iniciar somente o backend neste diretório.
BACKEND_PORT=4000
BACKEND_HOST=127.0.0.1
ANILIST_GRAPHQL_URL=https://graphql.anilist.co
MANGADEX_API_URL=https://api.mangadex.org
MANGADEX_BLOCKED_GROUP_IDS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT=180
# Cota separada para imagens, manifests e segmentos do player.
MEDIA_RATE_LIMIT=600
API_RATE_WINDOW_MS=60000
TOKO_API_URL=http://127.0.0.1:8099
TOKO_ENABLED=false
TOKO_TIMEOUT_MS=8000
TOKO_RETRIES=1
TOKO_CONTENT_AUTHORIZED=false
TOKO_ALLOWED_PROVIDERS=
TOKO_ALLOWED_MEDIA_HOSTS=
TOKO_ALLOWED_REQUEST_ORIGINS=
HPMOVIES_SOURCE_HOST_PORT=8099
HPMOVIES_EXTENSIONS_FILE=
TATAKAI_API_URL=http://127.0.0.1:8099
TATAKAI_ENABLED=true
TATAKAI_NAMESPACE=toko
TATAKAI_TIMEOUT_MS=8000
TATAKAI_RETRIES=0
TATAKAI_CONTENT_AUTHORIZED=false
TATAKAI_ALLOWED_PROVIDERS=
TATAKAI_ALLOWED_MEDIA_HOSTS=
TATAKAI_ALLOWED_REQUEST_ORIGINS=
STREMIO_ADDONS_JSON=[]
ENABLE_LEGACY_HIANIME=false
# Opcional; sem esta variável o cache limitado em memória funciona.
# ANIWATCH_API_REDIS_CONN_URL=redis://127.0.0.1:6379

# Legendas PT-BR/PT: OpenSubtitles REST/v3 e lançamentos curados revisados.
# Falhas das legendas não interrompem o vídeo.
EXTERNAL_SUBTITLES_ENABLED=true

# Domínios específicos de CDN de vídeo e legendas, incluindo seus subdomínios.
TOKO_ALLOWED_STREAM_DOMAINS=
TATAKAI_ALLOWED_STREAM_DOMAINS=
